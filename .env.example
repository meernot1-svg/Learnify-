# OPENROUTER_API_KEY: Server-side API key for OpenRouter AI routing (add in Settings > Secrets).
OPENROUTER_API_KEY=

# OPENROUTER_MODEL: Optional OpenRouter model slug (defaults to google/gemini-4-hydrogen).
OPENROUTER_MODEL=

# GEMINI_API_KEY: Optional server-side Gemini API key fallback.
GEMINI_API_KEY=

# MENTOR_ACCESS_CODE: Optional shared passcode for Mentor Command access verification.
MENTOR_ACCESS_CODE=

# ADMIN_ACCESS_CODE: Server-side passcode for Admin Panel access verification.
ADMIN_ACCESS_CODE=

# APP_URL: The URL where this applet is hosted.
APP_URL=
