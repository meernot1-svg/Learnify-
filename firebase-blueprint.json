{
  "entities": {
    "User": {
      "title": "User",
      "description": "Public-to-signed-in user profile information and role (PII isolated in private subcollection).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "username": { "type": "string", "minLength": 1, "maxLength": 50 },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "role": { "type": "string", "enum": ["Mentor", "Student"] },
        "achievements": { "type": "array" },
        "points": { "type": "integer" },
        "level": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "username", "fullName", "role", "achievements", "points", "createdAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII for a user (email, guardian name, phone, address).",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 256 },
        "fatherName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 40 },
        "address": { "type": "string", "maxLength": 300 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "updatedAt"]
    },
    "Material": {
      "title": "Material",
      "description": "Educational material like books, PDFs, or videos.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "subject": { "type": "string", "enum": ["computer", "physics", "biology", "chemistry"] },
        "type": { "type": "string", "enum": ["video", "book", "pdf"] },
        "url": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^https?://.*" },
        "mentorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "isPrioritized": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "description", "subject", "type", "url", "mentorId", "createdAt"]
    },
    "Course": {
      "title": "Course",
      "description": "A structured course consisting of multiple materials.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "subject": { "type": "string", "enum": ["computer", "physics", "biology", "chemistry"] },
        "mentorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "materialIds": { "type": "array" },
        "isPrioritized": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "description", "subject", "mentorId", "materialIds", "createdAt"]
    },
    "Progress": {
      "title": "Progress",
      "description": "Student progress tracking for specific materials.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "materialId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": { "type": "string", "enum": ["completed"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "materialId", "status", "updatedAt"]
    },
    "StudyReminder": {
      "title": "StudyReminder",
      "description": "Student study reminders.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "subject": { "type": "string", "minLength": 1, "maxLength": 100 },
        "topic": { "type": "string", "minLength": 1, "maxLength": 200 },
        "time": { "type": "string", "format": "date-time" },
        "isNotified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "subject", "topic", "time", "isNotified", "createdAt"]
    },
    "SavedQuiz": {
      "title": "SavedQuiz",
      "description": "Saved user quizzes with questions, score, timing, and study notes.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "subject": { "type": "string", "minLength": 1, "maxLength": 60 },
        "questions": { "type": "array" },
        "score": { "type": "integer" },
        "totalQuestions": { "type": "integer" },
        "timeSpentSeconds": { "type": "integer" },
        "isExamMode": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "subject", "questions", "score", "totalQuestions", "timeSpentSeconds", "isExamMode", "notes", "createdAt", "updatedAt"]
    },
    "LabResult": {
      "title": "LabResult",
      "description": "Saved virtual lab experiment results, measurements, and observations.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "experimentTitle": { "type": "string", "minLength": 1, "maxLength": 120 },
        "subject": { "type": "string", "enum": ["chemistry", "physics", "biology"] },
        "outcome": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "formula": { "type": "string", "maxLength": 200 },
        "measurements": { "type": "string", "maxLength": 1000 },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "experimentTitle", "subject", "outcome", "formula", "measurements", "notes", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Users and their roles (without PII)."
    },
    "/users/{userId}/private/{docId}": {
      "schema": "UserPrivateInfo",
      "description": "Isolated PII for each user."
    },
    "/materials/{materialId}": {
      "schema": "Material",
      "description": "Educational materials created by mentors."
    },
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "Courses created by mentors."
    },
    "/progress/{progressId}": {
      "schema": "Progress",
      "description": "Tracking student completion."
    },
    "/reminders/{reminderId}": {
      "schema": "StudyReminder",
      "description": "User-specific study reminders."
    },
    "/savedQuizzes/{quizId}": {
      "schema": "SavedQuiz",
      "description": "User-owned saved quiz attempts and question sets."
    },
    "/labResults/{resultId}": {
      "schema": "LabResult",
      "description": "User-owned virtual lab experiment results."
    }
  }
}
